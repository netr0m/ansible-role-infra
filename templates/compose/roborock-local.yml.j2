# {{ ansible_managed }}
services:
  {{ infra_roborock_local_service_name }}:
    image: {{ infra_roborock_local_container_image }}
    container_name: {{ infra_roborock_local_container_hostname }}
    hostname: {{ infra_roborock_local_container_hostname }}
    restart: {{ infra_roborock_local_restart_policy | default(infra_restart_policy) }}
    logging:
      driver: {{ svc_log_driver }}
      options: {{ svc_log_options }}
    env_file: {{ infra_roborock_local_env_file_path }}
    volumes:
      - {{ infra_roborock_local_config_file_path }}:/app/config.toml:ro
      - {{ infra_roborock_local_volume_name_data }}:/data
    mem_limit: {{ infra_roborock_local_container_memory }}
    labels:
      traefik.enable: 'true'
      traefik.docker.network: {{ svc_docker_network_name }}
      # HTTPS
      traefik.http.routers.{{ infra_roborock_local_service_name }}-rtr.rule: "Host(\"{{ infra_roborock_local_fqdn }}\")"
      traefik.http.routers.{{ infra_roborock_local_service_name }}-rtr.entrypoints: webSecure
{% if infra_roborock_local_use_actalis %}
      traefik.http.routers.{{ infra_roborock_local_service_name }}-rtr.tls.certresolver: actalis
{% endif %}
      traefik.http.services.{{ infra_roborock_local_service_name }}-svc.loadbalancer.server.port: {{ infra_roborock_local_https_port }}
      traefik.http.services.{{ infra_roborock_local_service_name }}-svc.loadbalancer.server.scheme: http
      traefik.http.routers.{{ infra_roborock_local_service_name }}-rtr.service: {{ infra_roborock_local_service_name }}-svc
      traefik.http.routers.{{ infra_roborock_local_service_name }}-rtr.middlewares: {{ infra_roborock_local_traefik_middlewares | join(',') }}
      # MQTT-TLS/tcp
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.rule: "HostSNI(\"{{ infra_roborock_local_fqdn }}\")"
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.entrypoints: {{ infra_roborock_local_traefik_mqtt_entrypoint }}
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.service: {{ infra_roborock_local_service_name }}-mqtt-svc
{% if infra_roborock_local_use_actalis %}
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.tls.certresolver: actalis
{% else %}
      # Reuses the wildcard certificate from the webSecure entrypoint
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.tls: 'true'
{% endif %}
{% if infra_roborock_local_mqtt_legacy_tls %}
      traefik.tcp.routers.{{ infra_roborock_local_service_name }}-mqtt-rtr.tls.options: roborock-local-legacy@file
{% endif %}
      traefik.tcp.services.{{ infra_roborock_local_service_name }}-mqtt-svc.loadbalancer.server.port: {{ infra_roborock_local_mqtt_tls_port }}
      docker-volume-backup.stop-during-backup: "{{ infra_roborock_local_service_name }}"
    networks:
      - {{ svc_docker_network_name }}
{% if infra_containers_override_dns %}
    dns: {{ infra_container_dns_servers }}
{% endif %}
    healthcheck:
      test: ['CMD', 'curl', '-sf', 'http://127.0.0.1:{{ infra_roborock_local_https_port }}/admin']
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

volumes:
  {{ infra_roborock_local_volume_name_data }}:
    name: {{ infra_roborock_local_volume_name_data }}
    labels: {{ infra_roborock_local_volume_labels | combine(infra_docker_volume_shared_labels) }}

networks:
  {{ svc_docker_network_name }}:
    external: 'true'
