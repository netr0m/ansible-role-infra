# {{ ansible_managed }}
# See https://unbound.docs.nlnetlabs.nl/en/latest/manpages/unbound.conf.html
{# slabs reduce lock contention between threads, and must be a power of 2 >= num-threads #}
{% set _slabs = 2 ** ((infra_unbound_num_threads | int | log(2)) | round(0, 'ceil') | int) %}
server:
    ###########################################################################
    # IMAGE SETTINGS (madnuttah/unbound)
    ###########################################################################
    # The image is distroless: no chroot, and privileges are dropped by the
    # entrypoint (UNBOUND_UID/UNBOUND_GID), so both must be empty
    directory: "/usr/local/unbound"
    chroot: ""
    username: ""
    pidfile: "/usr/local/unbound/unbound.d/unbound.pid"
    do-daemonize: no
    use-syslog: no
    # Trust anchor shipped with the image, tracked with RFC 5011 probes
    auto-trust-anchor-file: "/usr/local/unbound/iana.d/root.key"
    tls-cert-bundle: /etc/ssl/certs/ca-certificates.crt

    ###########################################################################
    # LOGGING
    ###########################################################################
    # Log to stderr, i.e. 'docker logs'
    logfile: ""
    log-time-ascii: yes
    verbosity: {{ infra_unbound_verbosity }}
    log-queries: no
    log-replies: no
    log-local-actions: no
    log-servfail: no

    ###########################################################################
    # LISTENING
    ###########################################################################
    interface: {{ infra_unbound_listening_iface }}
    port: {{ infra_unbound_listening_port }}
    do-ip4: {{ infra_unbound_ipv4 }}
    do-ip6: {{ infra_unbound_ipv6 }}
    do-udp: {{ infra_unbound_udp }}
    do-tcp: {{ infra_unbound_tcp }}
    # Leave this to no unless you have *native* IPv6
    prefer-ip6: {{ infra_unbound_prefer_ipv6 }}

    ###########################################################################
    # ACCESS CONTROL
    ###########################################################################
{% if infra_unbound_restrict_access %}
    access-control: 0.0.0.0/0 refuse
    access-control: ::0/0 refuse
    access-control: 127.0.0.1/32 allow
    access-control: ::1/128 allow
{% if _svc_network_subnet is defined %}
    access-control: {{ _svc_network_subnet }} allow
{% endif %}
{% for _subnet in infra_unbound_access_control_allowed_subnets %}
    access-control: {{ _subnet }} allow
{% endfor %}
{% else %}
    access-control: 0.0.0.0/0 allow
    access-control: ::0/0 allow
{% endif %}

    ###########################################################################
    # SECURITY & PRIVACY
    ###########################################################################
    module-config: "validator iterator"
    # Require DNSSEC data for trust-anchored zones, if absent the zone becomes bogus
    harden-dnssec-stripped: {{ infra_unbound_harden_dnssec_stripped }}
    # Trust glue only if it is within the server's authority
    harden-glue: {{ infra_unbound_harden_glue }}
    harden-algo-downgrade: yes
    # RFC 8020. Return NXDOMAIN for names below a known NXDOMAIN
    harden-below-nxdomain: yes
    harden-large-queries: yes
    harden-short-bufsize: yes
    hide-identity: yes
    hide-version: yes
    hide-trustanchor: yes
    # Send minimal information to upstream servers
    qname-minimisation: yes
    # Capitalization randomization is known to cause DNSSEC issues, see
    # https://discourse.pi-hole.net/t/unbound-stubby-or-dnscrypt-proxy/9378
    use-caps-for-id: no
    # Respond to ANY queries with a short answer
    deny-any: yes
    do-not-query-localhost: yes
    # Remove unsigned data from the additional section of secure messages
    val-clean-additional: yes
    # Clear the caches if this many unwanted replies are seen (cache poisoning defence)
    unwanted-reply-threshold: 10000000

    # DNS rebinding protection: strip private addresses from public answers
    private-address: 10.0.0.0/8
    private-address: 172.16.0.0/12
    private-address: 192.168.0.0/16
    private-address: 169.254.0.0/16
    private-address: fd00::/8
    private-address: fe80::/10
    private-address: ::ffff:0:0/96
    # Ensure no reverse queries to non-public IP ranges (RFC 6303 4.2)
    private-address: 192.0.2.0/24
    private-address: 198.51.100.0/24
    private-address: 203.0.113.0/24
    private-address: 255.255.255.255/32
    private-address: 2001:db8::/32

    ###########################################################################
    # PERFORMANCE
    ###########################################################################
    # https://unbound.docs.nlnetlabs.nl/en/latest/topics/core/performance.html
    num-threads: {{ infra_unbound_num_threads }}
    msg-cache-slabs: {{ _slabs }}
    rrset-cache-slabs: {{ _slabs }}
    infra-cache-slabs: {{ _slabs }}
    key-cache-slabs: {{ _slabs }}
    # Use roughly twice as much rrset cache memory as msg cache memory
    msg-cache-size: {{ infra_unbound_msg_cache_size }}
    rrset-cache-size: {{ infra_unbound_rrset_cache_size }}
    neg-cache-size: 4m
    outgoing-range: 8192
    num-queries-per-thread: 4096
    # Distribute incoming queries evenly across threads
    so-reuseport: yes

    # Respect the TTLs set by the domain owners
    cache-min-ttl: 0
    cache-max-ttl: 86400
    # Refresh frequently queried entries before they expire
    prefetch: {{ infra_unbound_prefetch }}
    prefetch-key: yes
    # RFC 8767. Answer from expired cache only if resolving takes longer than
    # the client timeout (ms), and never with data older than the expired TTL (s)
    serve-expired: {{ infra_unbound_serve_expired }}
    serve-expired-ttl: 86400
    serve-expired-client-timeout: 1800
    # RFC 8198. Synthesize negative answers from cached NSEC records
    aggressive-nsec: yes
    # Omit authority/additional sections when not required, avoiding TCP fallback
    minimal-responses: yes
    rrset-roundrobin: yes
    # Keep closed UDP ports around (ms) so late replies are not counted as unwanted
    delay-close: 10000

    # DNS Flag Day 2020. Avoid IP fragmentation, fall back to TCP for large answers
    edns-buffer-size: {{ infra_unbound_edns_buffer_size }}

    include: "/usr/local/unbound/conf.d/*.conf"
{% if infra_unbound_use_root_zone %}

###############################################################################
# LOCAL ROOT ZONE
###############################################################################
# RFC 8806. Keep a validated copy of the root zone to answer root and TLD
# lookups locally. Falls back to regular recursion if the transfer fails.
auth-zone:
    name: "."
    primary: 170.247.170.2        # b.root-servers.net
    primary: 192.33.4.12          # c.root-servers.net
    primary: 199.7.91.13          # d.root-servers.net
    primary: 192.5.5.241          # f.root-servers.net
    primary: 192.112.36.4         # g.root-servers.net
    primary: 193.0.14.129         # k.root-servers.net
    primary: 192.0.47.132         # xfr.cjr.dns.icann.org
    primary: 192.0.32.132         # xfr.lax.dns.icann.org
    primary: 2801:1b8:10::b       # b.root-servers.net
    primary: 2001:500:2::c        # c.root-servers.net
    primary: 2001:500:2d::d       # d.root-servers.net
    primary: 2001:500:2f::f       # f.root-servers.net
    primary: 2001:500:12::d0d     # g.root-servers.net
    primary: 2001:7fd::1          # k.root-servers.net
    primary: 2620:0:2830:202::132 # xfr.cjr.dns.icann.org
    primary: 2620:0:2d0:202::132  # xfr.lax.dns.icann.org
    fallback-enabled: yes
    for-downstream: no
    for-upstream: yes
    zonemd-check: yes
    zonemd-reject-absence: no
    zonefile: "/usr/local/unbound/iana.d/root.zone"
{% endif %}
